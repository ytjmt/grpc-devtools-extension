{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":pinAllExceptPeerDependencies"],
  "ignorePresets": ["helpers:pinGitHubActionDigests"],
  "enabledManagers": ["npm", "github-actions", "mise", "custom.regex"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "platformCommit": "enabled",
  "constraints": {
    "ghActionsLock": "v0.5.1"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dependencies",
      "groupSlug": "npm-non-major",
      "automerge": true
    },
    {
      "description": "Renovate merges these itself once every check passes, because the actions.lock verify is not a required check.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major",
      "groupSlug": "github-actions-non-major",
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools"
    },
    {
      "description": "mise.toml and package.json pin pnpm together.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "groupSlug": "pnpm",
      "automerge": false
    },
    {
      "description": "CI verifies actions.lock with the mise.toml version, and Renovate regenerates it with constraints.ghActionsLock.",
      "matchPackageNames": ["github/gh-actions-lock"],
      "groupName": "gh-actions-lock",
      "groupSlug": "gh-actions-lock"
    },
    {
      "description": "Regenerates the example code when its generators change.",
      "matchPackageNames": [
        "bufbuild/buf",
        "protocolbuffers/protobuf",
        "@bufbuild/protobuf",
        "@bufbuild/protoc-gen-es"
      ],
      "postUpgradeTasks": {
        "commands": [
          "mise trust",
          "mise install node pnpm buf protoc",
          "mise exec -- pnpm install --frozen-lockfile --ignore-scripts",
          "mise run example:gen"
        ],
        "executionMode": "branch",
        "installTools": {
          "mise": {}
        }
      }
    },
    {
      "description": "vp migrate moves the rest of the catalog with vite-plus.",
      "matchDepTypes": ["pnpm.catalog.default"],
      "matchPackageNames": ["!vite-plus"],
      "enabled": false
    },
    {
      "description": "vp migrate exempts the toolchain from minimumReleaseAge, so the exemption is removed again. Renovate's catalog edit requotes pnpm-workspace.yaml, so it is formatted last.",
      "matchPackageNames": ["vite-plus"],
      "groupName": "Vite+",
      "groupSlug": "vite-plus",
      "automerge": false,
      "postUpgradeTasks": {
        "commands": [
          "mise trust",
          "mise install node pnpm",
          "mise exec -- pnpm --package=vite-plus@{{{newVersion}}} dlx vp migrate --no-interactive --no-agent --no-editor --no-hooks",
          "mise exec -- pnpm config delete minimumReleaseAgeExclude --location project",
          "mise exec -- pnpm install --no-frozen-lockfile --ignore-scripts",
          "mise exec -- vp fmt pnpm-workspace.yaml"
        ],
        "executionMode": "branch",
        "installTools": {
          "mise": {}
        }
      }
    },
    {
      "matchPackageNames": ["renovate"],
      "groupName": "Renovate",
      "groupSlug": "renovate",
      "automerge": false
    },
    {
      "description": "The renovate-version input moves with the npm package through the custom manager, so both copies pick the same release.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["ghcr.io/renovatebot/renovate"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/actions-lock\\.yml$/", "/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": ["--package=renovate@(?<currentValue>\\S+)", "renovate-version: (?<currentValue>\\S+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^renovate\\.json$/"],
      "matchStrings": ["\"ghActionsLock\": \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ]
}
