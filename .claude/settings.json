{
  "permissions": {
    "allow": [
      "Bash(vp check)",
      "Bash(vp check --fix)",
      "Bash(vp test run)",
      "Bash(vp test run *)",
      "Bash(vp run build)",
      "Bash(vp run test)",
      "Bash(vp run test:*)",
      "Bash(actionlint)",
      "Bash(gh-actions-lock --verify-local *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/regenerate-example.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
