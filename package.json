{
  "name": "grpc-devtools-extension",
  "version": "0.1.0",
  "description": "Chrome DevTools extension for inspecting gRPC-Web / Connect traffic",
  "license": "MIT",
  "scripts": {
    "build": "vite build -c extension/vite.config.ts",
    "dev": "vite build -c extension/vite.config.ts --watch",
    "typecheck": "tsc -p .",
    "test": "vitest run --project unit --project component",
    "test:e2e": "pnpm build && playwright test",
    "example:gen": "mise run example:gen",
    "example:build": "vite build -c example/client/vite.config.ts",
    "example:serve": "tsx example/server/server.ts",
    "fixtures:record": "pnpm build && RECORD_FIXTURES=1 playwright test record-fixtures",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:vrt": "docker compose up -d --wait playwright && vitest run --project vrt"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "private": true
}
