{
  "name": "grpc-devtools-extension",
  "version": "0.1.2",
  "private": true,
  "description": "Chrome DevTools extension for inspecting gRPC-Web / Connect traffic",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp build -c extension/vite.config.ts",
    "dev": "vp build -c extension/vite.config.ts --watch",
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "vp test run --project unit --project component",
    "test:e2e": "vp run build && playwright test",
    "example:gen": "mise run example:gen",
    "example:build": "vp build -c example/client/vite.config.ts",
    "example:serve": "tsx example/server/server.ts",
    "fixtures:record": "vp run build && RECORD_FIXTURES=1 playwright test record-fixtures",
    "demo:record": "vp run build && RECORD_DEMO=1 playwright test record-demo",
    "test:unit": "vp test run --project unit",
    "test:component": "vp test run --project component",
    "test:vrt": "PLAYWRIGHT_VERSION=$(node -p \"require('@playwright/test/package.json').version\") docker compose up -d --wait playwright && vp test run --project vrt",
    "prepare": "vp config --no-agent",
    "package": "scripts/package.sh",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
